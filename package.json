{
  "name": "craftdesk",
  "productName": "CraftDesk",
  "version": "1.0.0",
  "description": "Minecraft 多服务器管理器",
  "main": "./out/main/index.js",
  "author": "CraftDesk",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "app": "node scripts/run-app.mjs",
    "app:test": "node scripts/run-app.mjs --isolated",
    "app:stop": "node scripts/run-app.mjs --stop",
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs --all",
    "dist:dir": "electron-vite build && electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.craftdesk.app",
    "productName": "CraftDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CraftDesk-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "CraftDesk-${version}"
    }
  }
}
